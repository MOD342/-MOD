{
  "appId": "com.animemod.otakuhub",
  "appName": "أنمي MOD",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "anime-mod-production.up.railway.app",
      "*.up.railway.app",
      "*.firebaseapp.com",
      "*.web.app",
      "*.firebaseio.com",
      "*.googleapis.com",
      "accounts.google.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": false,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
