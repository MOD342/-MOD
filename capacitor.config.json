    "allowNavigation": [
      "*.run.app",
      "*.anilist.co",
      "*.myanimelist.net",
      "*.googleapis.com",
      "*.firebaseio.com",
      "*.vidlink.pro",
      "*.autoembed.cc",
      "*.2embed.cc",
      "*.vidsrc.cc",
      "*.vidsrc.icu",
      "*.superembed.stream"
    ]
  },
