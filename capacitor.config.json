{
  "appId": "com.zoryx",
  "appName": "أنمي MOD",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "*.vercel.app",
      "*.onrender.com",
      "*.hf.space",
      "*.firebaseapp.com",
      "*.web.app",
      "*.firebaseio.com",
      "*.googleapis.com",
      "accounts.google.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
