# .env.example
# ==============================================================================
# 1. إعدادات الخادم الخلفي (Backend Server - Railway / Render / VPS / Local)
# ==============================================================================
# منفذ الخادم عند التشغيل المستقل
PORT=3000

# مفتاح Gemini API لتفعيل المحادثة الذكية، الألعاب، والترجمة
GEMINI_API_KEY=

# اختياري في Cloudflare Workers: رابط خادم خلفي خارجي (Render / Hugging Face) إذا أردت تمرير طلبات البث والسكرابر عبره
BACKEND_API_URL=

# سر اختياري لتوقيع روابط البث والتحميل المباشرة على Cloudflare Workers Edge (اختياري)
EDGE_TOKEN_SECRET=

# ==============================================================================
# 2. إعدادات تطبيق الواجهة و الـ APK (Frontend & Capacitor APK)
# ==============================================================================
# رابط الخادم / Cloudflare Worker المربوط بـ GitHub
# الرابط الفعلي المعتمد: https://mod.z-mod342.workers.dev
VITE_API_URL=https://mod.z-mod342.workers.dev

# معرف عميل Google OAuth للويب والأندرويد
VITE_GOOGLE_CLIENT_ID=

# ==============================================================================
# 3. إعدادات Firebase المستقلة (اختياري - عند النقل لحساب Firebase خاص بك)
# إذا تركتها فارغة سيتم استخدام ملف firebase-applet-config.json الافتراضي
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# إعدادات Firebase Admin SDK للخادم الخلفي (عند نقل مشروع Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
# ضع نص JSON لحساب الخدمة أو استخدم FIREBASE_CLIENT_EMAIL و FIREBASE_PRIVATE_KEY
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
